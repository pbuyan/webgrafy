{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{const f=(JSON.parse(d).tool_input||{}).file_path||'';if(/\\.(ts|tsx|js|jsx|mjs|mts)$/.test(f)){const {spawnSync}=require('child_process');const r=spawnSync('pnpm',['exec','eslint',f],{stdio:'inherit'});process.exit(r.status||0);}});\"",
            "timeout": 30,
            "statusMessage": "Linting..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true
  }
}
