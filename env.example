# Canonical production origin (www). Apex webgrafy.com should redirect here
# (see vercel.json). No trailing slash.
NEXT_PUBLIC_BASE_URL=https://www.webgrafy.com

# Resend — required for contact form email delivery
# Get your API key at https://resend.com/api-keys
# The sending domain must be verified in Resend before going live.
RESEND_API_KEY=re_...

# Sender address — must use a domain verified in Resend (e.g. contact.webgrafy.com)
RESEND_FROM_EMAIL=Webgrafy Contact <noreply@contact.webgrafy.com>

# Email address that receives contact form submissions
CONTACT_EMAIL=info@webgrafy.com

# Resend Audience — optional. When set, newsletter subscribers (/api/subscribe)
# are added to this mailing list. Create one at https://resend.com/audiences
RESEND_AUDIENCE_ID=

# Cal.com booking link for the "Book a Call" page. Accepts a full URL
# (https://cal.com/webgrafy/discovery) or a bare handle/slug (webgrafy/discovery).
# When empty, the /book page shows a contact-form fallback instead of the embed.
NEXT_PUBLIC_CALCOM_LINK=

# Upstash Redis — optional but recommended for serverless/edge deployments.
# Without these, the contact form rate limiter falls back to per-instance,
# in-memory limiting (unreliable across serverless instances).
# Create a database at https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error monitoring — optional. When set, server and client errors are POSTed to
# this webhook (e.g. a Slack/Discord incoming webhook or a custom endpoint) in
# addition to structured stderr logging. Leave empty to log only.
ERROR_WEBHOOK_URL=
